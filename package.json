{
  "name": "cockpit-tools",
  "private": true,
  "version": "1.3.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "nx": "nx",
    "nx:graph": "nx graph",
    "verify": "nx run cockpit-tools:verify",
    "test:web": "node scripts/run-web-tests.mjs",
    "test:managed-web": "node scripts/run-web-tests.mjs --match=codexManagedTask",
    "test:supervisor": "cargo test -p codex-task-supervisor --no-fail-fast",
    "test:managed-runtime": "cargo test -p cockpit-tools managed_task --lib --no-fail-fast",
    "test:account-exporter": "node --test tools/cockpit-account-exporter/test/*.test.cjs",
    "test:account-conversion": "node scripts/run-web-tests.mjs --match=accountConversionChallenges && cargo test -p cockpit-tools account_conversion_bridge --lib --no-fail-fast && powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/test-account-conversion-live-origin-files.ps1",
    "account-exporter:web": "node tools/cockpit-account-exporter/cockpit-account-exporter-web.cjs",
    "verify:upstreams": "node scripts/verify-upstream-contracts.mjs && cargo test -p codex-task-supervisor --test upstream_contracts --no-fail-fast",
    "test:codex-api-key-scope": "node --test src/utils/codexApiKeyAccountScope.test.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck",
    "build": "npm run sync-version && tsc && vite build",
    "release:preflight": "node scripts/release/preflight.cjs",
    "preview": "vite preview",
    "pretauri:dev": "npm run typecheck",
    "tauri:dev": "node scripts/tauri-dev.cjs",
    "pretauri": "npm run typecheck",
    "tauri": "node scripts/tauri.cjs",
    "sync-version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "blueimp-md5": "^2.19.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.14",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.562.0",
    "otpauth": "^9.5.0",
    "otplib": "^13.4.0",
    "protobufjs": "^8.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.3",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/blueimp-md5": "^2.18.2",
    "@types/otplib": "^7.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "electron": "^42.4.0",
    "nx": "^23.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
