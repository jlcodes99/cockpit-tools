  {
    "name": "custom_function_history",
    "input": {
      "model": "fixture",
      "tools": [
        {
          "type": "custom",
          "name": "apply_patch",
          "format": {
            "type": "text"
          }
        }
      ],
      "tool_choice": {
        "type": "function",
        "function": {
          "name": "apply_patch"
        }
      },
      "messages": [
        {
          "role": "assistant",
          "tool_calls": [
            {
              "id": "call_fixture",
              "type": "function",
              "function": {
                "name": "apply_patch",
                "arguments": "raw 250ms cipher"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call_fixture",
          "content": "done"
        }
      ]
    },
    "expected": {
      "input": [
        {
          "type": "custom_tool_call",
          "call_id": "call_fixture",
          "name": "apply_patch",
          "input": "raw 250ms cipher"
        },
        {
          "type": "custom_tool_call_output",
          "call_id": "call_fixture",
          "output": "done"
        }
      ],
      "tool_choice": {
        "type": "custom",
        "name": "apply_patch"
      },
      "tools": [
        {
          "type": "custom",
          "name": "apply_patch",
          "format": {
            "type": "text"
          }
        }
      ]
    },
    "history": true
  },
